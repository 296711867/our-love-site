<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · <%= s.site_name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>:root{--theme:<%= s.theme_color %>;--theme-dark:<%= themeDark %>}</style>
</head>
<body data-since="<%= s.since_date %>">
<header class="topbar">
  <div class="wrap bar-in">
    <a class="logo" href="/">💞 <span><%= s.site_name %></span></a>
    <nav>
      <a href="/" class="<%= active==='home'?'on':'' %>">首页</a>
      <a href="/photos" class="<%= active==='photos'?'on':'' %>">相册</a>
      <a href="/messages" class="<%= active==='messages'?'on':'' %>">情书</a>
      <a href="/anniversaries" class="<%= active==='anniv'?'on':'' %>">纪念日</a>
      <% if (isAdmin) { %><a href="/admin" class="<%= active==='admin'?'on':'' %>">管理</a><% } %>
    </nav>
  </div>
</header>
<main class="wrap">
