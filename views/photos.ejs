<%- include('partials/lg-head', { title: '照片墙' }) %>

<h4 class="text-ce central">记录下我们的最美瞬间</h4>
<div class="row central">
  <% if (!photos.length) { %>
  <div class="central" style="padding:2rem 0">
    <div class="title"><h1>相册还是空的，快去上传第一张合照吧</h1></div>
    <% if (isAdmin) { %><a class="lg-btn" href="/admin#photos" style="text-decoration:none">去上传</a><% } %>
  </div>
  <% } %>
  <% photos.forEach(function(p, i){ %>
  <div class="img_card col-lg-4 col-md-6 col-sm-12 col-sm-x-12 polaroid" style="--tilt: <%= i % 2 === 0 ? '-1.3deg' : '1.2deg' %>">
    <span class="polaroid-tape"></span>
    <div class="love_img">
      <a class="lb-item" href="javascript:void(0)" data-src="/img/o/<%= p.id %>" data-cap="<%= p.caption %>" data-date="<%= fmtDate(p.taken_at) %>">
        <img loading="lazy" src="/img/t/<%= p.id %>" alt="<%= p.caption %>">
      </a>
    </div>
    <div class="polaroid-caption">
      <% if (p.caption) { %><span class="p-cap"><%= p.caption %></span><% } %>
      <span class="p-date"><%= fmtDate(p.taken_at) %></span>
    </div>
  </div>
  <% }) %>
</div>

<% if (isAdmin) { %><a class="admin-float" href="/admin#photos">⚙️ 管理</a><% } %>

<%- include('partials/lg-foot') %>
